*.iml
.idea/
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Captures and Native Build files
captures/
.externalNativeBuild/
.cxx/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Log Files
*.log

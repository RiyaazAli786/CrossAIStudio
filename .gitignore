*.ap_
*.aab

# Java class files & dex
*.class
*.dex

# Generated build directories
build/
*/build/
bin/
gen/
out/
buildOutput/

# Gradle files
.gradle/
.kotlin/

# Local configuration file (contains machine-specific Android SDK paths)
local.properties


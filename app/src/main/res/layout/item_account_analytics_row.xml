<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Column 1: Account (140dp) -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPlatformSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_instagram" />

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="\@username"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Column 2: Platform Badge (90dp) -->
    <TextView
        android:id="@+id/tvPlatformBadge"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Instagram"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Column 3: Total Published (80dp) -->
    <TextView
        android:id="@+id/tvPublishedCount"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="12"
        android:textColor="@color/status_green"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Column 4: Total Failed (70dp) -->
    <TextView
        android:id="@+id/tvFailedCount"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/status_red"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Column 5: Success Rate (85dp) -->
    <TextView
        android:id="@+id/tvSuccessRate"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:text="100.0%"
        android:textColor="@color/status_blue"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Column 6: Status Badge (100dp) -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_active"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="ACTIVE"
        android:textColor="@color/status_green"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
